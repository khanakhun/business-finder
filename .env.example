# Business Finder — environment variables. Copy to .env and fill in what you need.
# Generated by `pnpm env:example` from @bf/config; do not edit by hand. Reference: docs/ENVIRONMENT.md
#
# Precedence: real environment > .env.generated (written by `pnpm infra:up`) > .env > defaults.
# Commented-out lines show the default; uncomment to override.

# --- Local infrastructure (scripts/infra.mjs) ---
# Shift every host port by this amount (0, 10, …, 70) to run several checkouts side by side.
# BF_PORT_OFFSET=0
# Docker Compose project name; give each checkout its own.
# COMPOSE_PROJECT_NAME=bf
# Local-only credentials of the dev containers (defaults shown).
# POSTGRES_USER=bf
# POSTGRES_PASSWORD=bf_local_only
# POSTGRES_DB=bf
# BF_SITES_RO_PASSWORD=bf_sites_ro_local_only

# --- Core ---
# Runtime mode. Production enables secure cookies, JSON logs and stricter checks. (apps: api, worker, web, sites, intel)
# NODE_ENV=development
# Minimum log level. (apps: api, worker, web, sites, intel)
# LOG_LEVEL=info
# Public URL of the dashboard (apps/web). (apps: api, worker, web, sites)
# APP_URL=   # written by pnpm infra:up
# Public URL of the API (apps/api). (apps: api, worker, web, sites)
# API_URL=   # written by pnpm infra:up
# Previews are served at https://<slug>.<SITES_BASE_DOMAIN> (no scheme, no port). (apps: api, worker, sites)
# SITES_BASE_DOMAIN=sites.localhost
# Release version, set by the build/deploy pipeline. (apps: api, worker, sites, intel)
# APP_VERSION=0.0.0-dev
# Git commit SHA of the running build, set by the build/deploy pipeline. (apps: api, worker, sites)
# GIT_COMMIT=
# OTLP/HTTP endpoint for traces/metrics/logs (BF-005). Unset disables export. (apps: api, worker, sites, intel)
# OTEL_EXPORTER_OTLP_ENDPOINT=   # written by pnpm infra:up

# --- Database ---
# Read-write connection string (owner role; migrations and apps/api). Written by infra:up. (secret · apps: api, worker)
# DATABASE_URL=   # written by pnpm infra:up
# Max connections per process. (apps: api, worker)
# DB_POOL_MAX=10
# Read-only connection string (bf_sites_ro) used by apps/sites. Written by infra:up. (secret · apps: sites)
# SITES_DATABASE_URL=   # written by pnpm infra:up

# --- Valkey ---
# Valkey connection (BullMQ, cache, rate limits). May embed a password. Written by infra:up. (secret · apps: api, worker)
# VALKEY_URL=   # written by pnpm infra:up

# --- Object storage (S3) ---
# S3-compatible endpoint (RustFS locally). Written by infra:up. (apps: api, worker, sites, intel)
# S3_ENDPOINT=   # written by pnpm infra:up
# Bucket region. (apps: api, worker, sites, intel)
# S3_REGION=us-east-1
# S3 access key id. (secret · apps: api, worker, sites, intel)
# S3_ACCESS_KEY_ID=   # written by pnpm infra:up
# S3 secret access key. (secret · apps: api, worker, sites, intel)
# S3_SECRET_ACCESS_KEY=   # written by pnpm infra:up
# Path-style URLs (required by RustFS/MinIO; false for AWS). (apps: api, worker, sites, intel)
# S3_FORCE_PATH_STYLE=true
# Site assets (versioned). (apps: api, worker, sites, intel)
# S3_BUCKET_ASSETS=bf-assets
# Crawl artifacts, screenshots, models. (apps: api, worker, sites, intel)
# S3_BUCKET_ARTIFACTS=bf-artifacts
# Published static site exports. (apps: api, worker, sites, intel)
# S3_BUCKET_SITES=bf-sites

# --- AI providers ---
# Anthropic API key (LLM gateway, agents). (secret · apps: api, worker)
# ANTHROPIC_API_KEY=
# OpenAI API key (LLM gateway, Codex engine). (secret · apps: api, worker)
# OPENAI_API_KEY=
# JSON map overriding the prompt registry model per task, e.g. {"classify":"<model-id>"}. (apps: api, worker)
# AI_MODEL_OVERRIDES=
# Model for `fast` tasks. (apps: api, worker)
# AI_MODEL_FAST=claude-haiku-5-5
# Model for `smart` tasks. (apps: api, worker)
# AI_MODEL_SMART=claude-sonnet-5-5
# Model for `agent` tasks. (apps: api, worker)
# AI_MODEL_AGENT=claude-opus-5-5
# JSON map: model id or tier → models tried when it is unavailable, in order. (apps: api, worker)
# AI_MODEL_FALLBACKS=
# Embedding model (1536 dimensions by default). (apps: api, worker)
# AI_EMBEDDING_MODEL=openai:text-embedding-3-small
# JSON map: model id → USD per million input/output/cached tokens. Unpriced models cost null. (apps: api, worker)
# AI_PRICING=
# Per-workspace monthly AI spend that triggers a warning. (apps: api, worker)
# AI_BUDGET_MONTHLY_SOFT_USD=25
# Per-workspace monthly AI spend above which non-essential tasks stop. (apps: api, worker)
# AI_BUDGET_MONTHLY_HARD_USD=100
# Send prompt and response bodies to tracing/Langfuse (emails and phones masked). Keep off in production. (apps: api, worker)
# AI_TRACE_CONTENT=false
# Langfuse public key; tracing to Langfuse is off when unset. (apps: api, worker)
# LANGFUSE_PUBLIC_KEY=
# Langfuse secret key. (secret · apps: api, worker)
# LANGFUSE_SECRET_KEY=
# Langfuse host (cloud region or self-hosted). (apps: api, worker)
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Provider keys (workspace fallback) ---
# Google Places API key (discovery). (secret · apps: api, worker)
# GOOGLE_PLACES_API_KEY=
# PageSpeed Insights API key (audits). (secret · apps: api, worker)
# PAGESPEED_API_KEY=
# Foursquare Places API key (discovery). (secret · apps: api, worker)
# FOURSQUARE_API_KEY=
# Hugging Face access token. (secret · apps: api, worker)
# HF_TOKEN=
# Unsplash access key (stock photos). (secret · apps: api, worker)
# UNSPLASH_ACCESS_KEY=

# --- Auth & secrets ---
# Better Auth signing secret, ≥ 32 chars. Generate: openssl rand -base64 32 (secret · apps: api, worker)
BETTER_AUTH_SECRET=
# Who may create an account. Default: invite_only in production, open otherwise. (apps: api, worker)
# SIGNUP_MODE=
# Comma-separated email domains that may self-register when SIGNUP_MODE=allowlist. (apps: api, worker)
# SIGNUP_ALLOWED_EMAIL_DOMAINS=
# Comma-separated verified emails allowed to use cross-workspace operator tools (Bull Board, queue smoke test). (apps: api, worker)
# PLATFORM_OPERATOR_EMAILS=
# Reverse-proxy IPs/CIDRs in front of the API, for client-IP detection behind X-Forwarded-For. (apps: api, worker)
# AUTH_TRUSTED_PROXIES=
# Parent domain shared by app. and api. for the session cookie (e.g. example.com). Unset = host-only. (apps: api, worker)
# AUTH_COOKIE_DOMAIN=
# Reject passwords found in known breaches (k-anonymity queries to api.pwnedpasswords.com). (apps: api, worker)
# AUTH_CHECK_PWNED=true
# Google OAuth client id; Google sign-in is off when unset. (apps: api, worker)
# GOOGLE_CLIENT_ID=
# Google OAuth client secret. (secret · apps: api, worker)
# GOOGLE_CLIENT_SECRET=
# Master key wrapping workspace secret data keys (AES-256-GCM). Generate: openssl rand -base64 32 (secret · apps: api, worker)
SECRETS_MASTER_KEY=
# Version number of SECRETS_MASTER_KEY; bump it when rotating (docs/runbooks/secrets-rotation.md). (apps: api, worker)
# SECRETS_MASTER_KEY_VERSION=1
# Previous master key (version SECRETS_MASTER_KEY_VERSION − 1), kept only while rotating. (secret · apps: api, worker)
# SECRETS_MASTER_KEY_PREVIOUS=

# --- System mail ---
# System mail transport (verification, invites). Mailpit locally. May embed credentials. (secret · apps: api, worker)
# SMTP_URL=   # written by pnpm infra:up
# From header for system emails. Never used for prospect outreach. (apps: api, worker)
# MAIL_FROM=Business Finder <no-reply@localhost>

# --- Intel service ---
# Internal URL of services/intel. (apps: api, worker)
# INTEL_URL=   # written by pnpm infra:up
# Shared secret authenticating calls to services/intel, ≥ 32 chars. (secret · apps: api, worker, intel)
INTEL_SHARED_SECRET=

# --- Feature flags ---
# Enable the self-hosted Google Maps scraper provider. (apps: api, worker)
# FEATURE_MAPS_SCRAPER=false
# Enable coding-agent site generation engines. (apps: api, worker)
# FEATURE_CODING_ENGINES=true
# Allow sequences to send without per-message approval. (apps: api, worker)
# FEATURE_AUTO_SEND=false
# Register the fixture discovery provider (tests and E2E only; refused in production). (apps: api, worker)
# FAKE_DISCOVERY_PROVIDER=false
# Development/E2E only: provider connection tests succeed without calling providers. Refused in production. (apps: api, worker)
# FAKE_CONNECTION_TESTS=false

# --- App-specific ---
# Match score at or above which a source record is merged into an existing business. (apps: api, worker)
# RESOLUTION_MATCH_THRESHOLD=0.85
# Match score at or above which (below the match threshold) a new business is flagged as a possible duplicate. (apps: api, worker)
# RESOLUTION_POSSIBLE_THRESHOLD=0.6
# External geocoder used when an area is not in geo_areas (google uses the google_places secret). (apps: api, worker)
# GEOCODER_PROVIDER=nominatim
# Nominatim endpoint; point it at a self-hosted instance for volume. (apps: api, worker)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# External geocoder lookups each workspace may trigger per minute (cache hits are free). (apps: api, worker)
# GEOCODER_LOOKUPS_PER_MINUTE=20
# Contact address sent to Nominatim (User-Agent and `email` parameter), required by its policy. (apps: api, worker)
# NOMINATIM_CONTACT_EMAIL=
# Count providers' free monthly allowances (per billing account) before estimating cost. (apps: api, worker)
# DISCOVERY_APPLY_FREE_TIER=true
# Client-side cap on Google Places calls per second, per API key (Google allows ~100/s). (apps: api, worker)
# GOOGLE_PLACES_REQUESTS_PER_SECOND=5
# Overpass API endpoint. The public one is for light use: self-host or use a paid instance in production. (apps: api, worker)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Overpass calls per second (no parallel queries on public instances; raise for a self-hosted one). (apps: api, worker)
# OVERPASS_REQUESTS_PER_SECOND=0.1
# Contact address in the Overpass User-Agent (usage policy: identify the application). (apps: api, worker)
# OVERPASS_CONTACT_EMAIL=
# Self-hosted gosom/google-maps-scraper web API (only used with FEATURE_MAPS_SCRAPER). (apps: api, worker)
# MAPS_SCRAPER_URL=
# Time budget of one scraper job (the scraper needs at least 3 minutes). (apps: api, worker)
# MAPS_SCRAPER_MAX_TIME_SECONDS=300
# HTTP port of apps/api. Set by infra:up from BF_PORT_OFFSET. (apps: api)
# API_PORT=   # written by pnpm infra:up
# Prometheus metrics port of the worker process. (apps: worker)
# WORKER_METRICS_PORT=   # written by pnpm infra:up
# On SIGTERM, how long the worker waits for active jobs before exiting. (apps: worker)
# WORKER_SHUTDOWN_TIMEOUT_MS=30000
# HTTP port of apps/web. Set by infra:up from BF_PORT_OFFSET. (apps: web)
# WEB_PORT=   # written by pnpm infra:up
# API base URL used by the browser. (apps: web)
# NEXT_PUBLIC_API_URL=   # written by pnpm infra:up
# Dashboard URL used by the browser. (apps: web)
# NEXT_PUBLIC_APP_URL=   # written by pnpm infra:up
# HTTP port of apps/sites. Set by infra:up from BF_PORT_OFFSET. (apps: sites)
# SITES_PORT=   # written by pnpm infra:up
# Interface services/intel binds to (0.0.0.0 inside its container). (apps: intel)
# INTEL_HOST=127.0.0.1
# HTTP port of services/intel. Set by infra:up from BF_PORT_OFFSET. (apps: intel)
# INTEL_PORT=   # written by pnpm infra:up
# Uvicorn worker processes. Prefer more replicas: metrics and the nonce cache are per process. (apps: intel)
# INTEL_WORKERS=1
# Process-pool size for CPU-bound work (default: CPU count). (apps: intel)
# INTEL_CPU_WORKERS=
# Largest request body accepted on /v1, checked before authentication (bytes). (apps: intel)
# INTEL_MAX_REQUEST_BYTES=1048576
# Total time budget of one safe_fetch call, redirects included. (apps: intel)
# INTEL_FETCH_TIMEOUT_SECONDS=20
# Largest response body safe_fetch accepts after decompression (bytes). (apps: intel)
# INTEL_FETCH_MAX_BYTES=10485760
# Local directory for regional open-data extracts (BF-019), relative to services/intel. (apps: intel)
# OPEN_DATA_CACHE_DIR=.cache/open-data
# Also keep regional extracts in the artifacts bucket (open-data/…), shared by intel replicas. (apps: intel)
# OPEN_DATA_OBJECT_CACHE=false
# DuckDB extension directory (the image pre-installs httpfs there); DuckDB default when unset. (apps: intel)
# OPEN_DATA_EXTENSION_DIR=
# Size cap of the local extract cache (least recently used extracts are evicted). (apps: intel)
# OPEN_DATA_CACHE_MAX_MB=5120
# Time budget of one open-data query (a first extract downloads from the dataset bucket). (apps: intel)
# OPEN_DATA_QUERY_TIMEOUT_SECONDS=120
# DuckDB memory limit per open-data query. (apps: intel)
# OPEN_DATA_MEMORY_LIMIT=1GB
# Pinned Overture release (e.g. 2026-09-23.1); the latest from the STAC catalog when unset. (apps: intel)
# OVERTURE_RELEASE=
# Overture STAC root (its `latest` key names the current release). (apps: intel)
# OVERTURE_STAC_URL=https://stac.overturemaps.org/catalog.json
# Overture places parquet glob ({release} is substituted). Anonymous S3, us-west-2. (apps: intel)
# OVERTURE_SOURCE_URL=s3://overturemaps-us-west-2/release/{release}/theme=places/type=place/*.parquet
# Foursquare OS Places release directory (dt=…) on Hugging Face. (apps: intel)
# FOURSQUARE_RELEASE=2026-09-15
# Foursquare OS Places parquet glob ({release} substituted); gated, needs a Hugging Face token. (apps: intel)
# FOURSQUARE_SOURCE_URL=hf://datasets/foursquare/fsq-os-places/release/dt={release}/places/parquet/*.parquet
