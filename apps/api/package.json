{
  "name": "@bf/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS modular monolith: HTTP API (src/main.ts) and worker (src/worker.ts).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --import @swc-node/register/esm-register --import ./src/instrumentation.ts src/main.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts",
    "openapi": "node --import @swc-node/register/esm-register src/openapi.ts",
    "dev:worker": "node --import @swc-node/register/esm-register --import ./src/instrumentation.ts --watch src/worker.ts",
    "start:worker": "node --import @swc-node/register/esm-register --import ./src/instrumentation.ts src/worker.ts",
    "dev:api": "node --import @swc-node/register/esm-register --import ./src/instrumentation.ts --watch src/main.ts",
    "admin:bootstrap": "node --import @swc-node/register/esm-register src/cli/bootstrap.ts",
    "secrets:rotate-master": "node --import @swc-node/register/esm-register src/cli/rotate-master-key.ts",
    "bench:ingest": "BF_BENCH=1 vitest run --config vitest.int.config.ts src/modules/business-graph/resolution.bench.int.test.ts",
    "bench:discovery": "BF_BENCH=1 vitest run --config vitest.int.config.ts src/modules/discovery/runs.bench.int.test.ts",
    "bench:search": "BF_BENCH=1 vitest run --config vitest.int.config.ts src/modules/search/search.bench.int.test.ts",
    "geo:import": "node --import @swc-node/register/esm-register src/cli/geo-import.ts",
    "search:bench-seed": "node --import @swc-node/register/esm-register src/cli/search-bench-seed.ts",
    "search:reindex": "node --import @swc-node/register/esm-register --import ./src/instrumentation.ts src/cli/search-reindex.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@bf/ai": "workspace:*",
    "@bf/auth": "workspace:*",
    "@bf/config": "workspace:*",
    "@bf/contracts": "workspace:*",
    "@bf/db": "workspace:*",
    "@bf/observability": "workspace:*",
    "@bf/queue": "workspace:*",
    "@bull-board/api": "catalog:",
    "@bull-board/express": "catalog:",
    "@bull-board/nestjs": "catalog:",
    "@langfuse/otel": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@react-email/components": "catalog:",
    "@react-email/render": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@turf/area": "catalog:",
    "@turf/bbox": "catalog:",
    "@turf/boolean-intersects": "catalog:",
    "@turf/boolean-point-in-polygon": "catalog:",
    "@turf/centroid": "catalog:",
    "@turf/circle": "catalog:",
    "@turf/distance": "catalog:",
    "@turf/helpers": "catalog:",
    "@turf/intersect": "catalog:",
    "@turf/union": "catalog:",
    "@turf/voronoi": "catalog:",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "cockatiel": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "libphonenumber-js": "catalog:",
    "nodemailer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "tldts": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bf/testing": "workspace:*",
    "@bf/tsconfig": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@nestjs/testing": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@types/express": "catalog:",
    "@types/geojson": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ai": "catalog:",
    "fast-check": "catalog:",
    "otplib": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
