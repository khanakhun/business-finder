{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    // Reuse .gitignore instead of duplicating ignore lists.
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    // Markdown, YAML, Python, … are not Biome's job; don't report them as errors.
    "ignoreUnknown": true,
    // Lockfiles and generated artifacts are owned by their tools.
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!**/coverage",
      "!**/dist",
      "!**/.next",
      "!**/next-env.d.ts",
      "!**/.turbo",
      // Generated and checked by their own tests (`api:openapi`, `contracts:jsonschema`).
      "!packages/api-client/openapi.json",
      "!packages/api-client/src/schema.d.ts",
      "!packages/contracts/generated",
      // Third-party data written by their update scripts (BF-026): kept byte-for-byte as generated.
      "!services/intel/app/vendor",
      "!infra/compose/seccomp-chromium.json",
      // Eval fixture sites (BF-030): deliberately poor HTML for the vision grade, kept as rendered.
      "!packages/ai/evals/*/sites"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    // Wider than the 80 default: TypeScript generics and Zod chains wrap too eagerly at 80.
    "lineWidth": 110
  },
  "javascript": {
    "parser": {
      // NestJS constructor-parameter decorators (`@Inject(TOKEN) private readonly x`) are legacy TS syntax.
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      // Tailwind v4 directives (@theme, @custom-variant, @apply, @source) in the design system's CSS.
      "tailwindDirectives": true
    }
  },
  "json": {
    "parser": {
      // turbo.json, tsconfig and VS Code settings are JSONC; comments explain non-default settings.
      "allowComments": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Escalated from warn: coding-standards.md §1 bans `any`.
        "noExplicitAny": "error"
      },
      "style": {
        // Escalated from warn: named exports only (overrides below for framework-mandated defaults).
        "noDefaultExport": "error",
        "useImportType": "error",
        "useExportType": "error"
      },
      "nursery": {
        // Uses Biome's own type inference (no tsc); catches the common cases, see packages/README.md.
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      // NestJS DI reads constructor parameter types at runtime (emitDecoratorMetadata): an injected class used only
      // as a type must stay a value import. TypeScript's verbatimModuleSyntax still forces `import type` for
      // real types (interfaces, aliases), so nothing is lost.
      // Nest dynamic modules (`static forRoot()` on a decorated class) are static-only classes by design.
      "includes": ["apps/api/**"],
      "linter": {
        "rules": { "style": { "useImportType": "off" }, "complexity": { "noStaticOnlyClass": "off" } }
      }
    },
    {
      // AGENTS.md §3: @bf/contracts is the dependency leaf and must run in browsers/edge (BF-004).
      "includes": ["packages/contracts/src/**", "!packages/contracts/src/cli/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@bf/*"],
                    "message": "@bf/contracts is the leaf: it imports no other @bf package."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Tools load these through a default export.
      "includes": ["**/*.config.{ts,mts,js,mjs,cjs}"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // Next.js App Router conventions require default exports.
      "includes": [
        "apps/*/src/app/**/{page,layout,template,loading,error,global-error,not-found,default}.tsx",
        "apps/*/src/app/**/{opengraph-image,twitter-image,icon,apple-icon,sitemap,robots,manifest}.{ts,tsx}",
        "apps/*/src/{middleware,instrumentation}.ts",
        // next-intl loads its request config through a default export.
        "apps/*/src/i18n/request.ts"
      ],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // AGENTS.md §3: apps never import from another app. Relative cross-app paths are caught
      // by the boundaries check in CI (BF-009).
      "includes": ["apps/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@bf/web", "@bf/web/**", "@bf/api", "@bf/api/**", "@bf/sites", "@bf/sites/**"],
                    "message": "Apps must not import from other apps. Move shared code to a package in packages/."
                  },
                  {
                    // Relative paths that climb out of the app; a bare `**/apps/**` would also match
                    // folders that happen to be called `apps` inside a workspace.
                    "group": [
                      "../../apps/**",
                      "../../../apps/**",
                      "../../../../apps/**",
                      "../../../../../apps/**",
                      "../../../../../../apps/**"
                    ],
                    "message": "Apps must not import from other apps. Move shared code to a package in packages/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // AGENTS.md §3: packages never import from apps.
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@bf/web",
                      "@bf/web/**",
                      "@bf/api",
                      "@bf/api/**",
                      "@bf/sites",
                      "@bf/sites/**",
                      "../../apps/**",
                      "../../../apps/**",
                      "../../../../apps/**",
                      "../../../../../apps/**",
                      "../../../../../../apps/**"
                    ],
                    "message": "Packages must not depend on apps."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
