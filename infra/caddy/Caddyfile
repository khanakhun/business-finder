# Edge proxy for staging/production (BF-025, ADR-0014). Values come from the environment (compose passes them):
#   BASE_DOMAIN        app.{BASE_DOMAIN} → web, api.{BASE_DOMAIN} → api, u.{BASE_DOMAIN} → the API's unsubscribe routes
#   SITES_BASE_DOMAIN  *.{SITES_BASE_DOMAIN} → sites (apps/sites, BF-036)
#   ACME_EMAIL         account e-mail for Let's Encrypt
#   ACME_DNS_PROVIDER  DNS module for the wildcard (cloudflare by default; the image must include it)
#   ACME_DNS_API_TOKEN token of that provider (DNS edit on the zone only)
#   CADDY_TLS          `acme` (default) or `internal` (local test with Caddy's own CA)
#   DOMAIN_ASK_TOKEN   token of the on-demand TLS `ask` URL (BF-062: certificates for verified custom domains only)
{
	email {$ACME_EMAIL}
	# BF-062: certificates for live sites' custom domains, issued when a visitor first arrives — and only for names
	# the API allows (verified or active `site_domains`). Caddy sends no header, so the URL carries a token.
	on_demand_tls {
		ask http://api:4000/v1/internal/domains/allow?token={$DOMAIN_ASK_TOKEN}
	}
	# Admin API on loopback only (the healthcheck reads it).
	admin 127.0.0.1:2019
	# Error logs carry the request too: the same redaction as the access logs.
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace r REDACTED
				}
				# A same-origin Referer is the full address of the page, `?r=` included, as is a redirect's Location.
				request>headers>Referer delete
				resp_headers>Location delete
			}
		}
	}
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

(tls_acme) {
}

(tls_internal) {
	tls internal
}

(wildcard_tls_acme) {
	tls {
		dns {$ACME_DNS_PROVIDER:cloudflare} {$ACME_DNS_API_TOKEN}
	}
}

(wildcard_tls_internal) {
	tls internal
}

# Headers the apps may already set win (`?` only fills in what is missing): the dashboard sets its own CSP.
(security_headers) {
	header {
		?Strict-Transport-Security "max-age=63072000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "DENY"
		-Server
		-X-Powered-By
	}
}

# An e-mail's signed outreach reference (`?r=`, on preview links) names the prospect it was sent to, so it is never
# logged, not even in a Referer or a redirect's Location (docs/conventions/security.md §7).
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace r REDACTED
				}
				# A same-origin Referer is the full address of the page, `?r=` included, as is a redirect's Location.
				request>headers>Referer delete
				resp_headers>Location delete
			}
		}
	}
}

app.{$BASE_DOMAIN} {
	import tls_{$CADDY_TLS:acme}
	import security_headers
	import access_log
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	reverse_proxy web:3000 {
		# Streamed server rendering (Suspense boundaries) reaches the browser as it is produced.
		flush_interval -1
	}
}

api.{$BASE_DOMAIN} {
	import tls_{$CADDY_TLS:acme}
	import security_headers
	import access_log
	# BF-062: internal routes (Caddy's own ask) are reached on the internal network only, never from the internet.
	@internal path /v1/internal/*
	respond @internal 404
	# Never compress the realtime stream: compression buffers events (SSE, /v1/realtime).
	@compressible not header Accept text/event-stream*
	encode @compressible zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy api:4000 {
		# Stream responses as they are written (SSE).
		flush_interval -1
	}
}

# Unsubscribe links (BF-055): the short host in every message footer and the RFC 8058 one-click target. Only those
# routes reach the API; the token in the path identifies a recipient, so it is never logged.
u.{$BASE_DOMAIN} {
	import tls_{$CADDY_TLS:acme}
	import security_headers
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "^(/u/|/v1/public/unsubscribe/)[^?]*" "${1}REDACTED"
				request>headers>Referer delete
			}
		}
	}
	request_body {
		max_size 16KB
	}
	@unsubscribe path /u/* /v1/public/unsubscribe/*
	handle @unsubscribe {
		reverse_proxy api:4000
	}
	respond 404
}

*.{$SITES_BASE_DOMAIN} {
	import wildcard_tls_{$CADDY_TLS:acme}
	import security_headers
	import access_log
	encode zstd gzip
	# Published sites receive no uploads (their contact form posts to the API).
	request_body {
		max_size 64KB
	}
	# The renderer's internal routes are for the API (revalidation) and the container (health), never the public.
	@internal path /api/revalidate /health/*
	respond @internal 404
	# apps/sites (BF-036): every hostname of the sites domain; it answers 404 for one with no publication.
	reverse_proxy sites:3000
}

# BF-062: live sites on their own domains (any other name). The certificate is issued on demand when the API's ask
# endpoint allows the name; anything else gets no certificate (the TLS handshake fails), so nothing is served.
https:// {
	tls {
		on_demand
	}
	import security_headers
	import access_log
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	@internal path /api/revalidate /health/*
	respond @internal 404
	reverse_proxy sites:3000
}
