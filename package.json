{
  "name": "business-finder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "if [ -e .git ]; then lefthook install; fi",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:root": "biome check ./*.json ./*.jsonc ./*.mjs ./.vscode ./scripts ./tools",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:root": "node --test 'scripts/**/*.test.mjs' 'tools/**/*.test.mjs'",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:int": "turbo run test:int",
    "e2e": "turbo run e2e",
    "verify": "turbo run lint typecheck test",
    "format": "biome check --write .",
    "clean": "turbo run clean && rm -rf .turbo node_modules",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:reset": "node scripts/infra.mjs reset",
    "infra:logs": "node scripts/infra.mjs logs",
    "infra:status": "node scripts/infra.mjs status",
    "env:check": "node packages/config/src/cli/check.ts",
    "env:doc": "node packages/config/src/cli/generate.ts doc",
    "env:example": "node packages/config/src/cli/generate.ts example",
    "db:generate": "node packages/db/src/cli/kit.ts generate",
    "db:migrate": "node packages/db/src/cli/migrate.ts",
    "db:check": "node packages/db/src/cli/kit.ts check",
    "db:seed": "node packages/db/src/cli/seed.ts",
    "db:studio": "node packages/db/src/cli/kit.ts studio",
    "db:reset": "node packages/db/src/cli/reset.ts",
    "admin:bootstrap": "pnpm --filter @bf/api admin:bootstrap --",
    "secrets:rotate-master": "pnpm --filter @bf/api secrets:rotate-master",
    "contracts:jsonschema": "node packages/contracts/src/cli/jsonschema.ts",
    "contracts:py": "pnpm contracts:jsonschema && pnpm --filter @bf/intel contracts",
    "contracts:check": "node packages/contracts/src/cli/jsonschema.ts --check && pnpm --filter @bf/intel contracts --check",
    "eval": "pnpm --filter @bf/ai eval --",
    "api:openapi": "pnpm --filter @bf/api openapi",
    "api:codegen": "pnpm api:openapi && pnpm --filter @bf/api-client codegen",
    "gen:module": "node tools/generators/module/cli.mjs",
    "gen:module:check": "node tools/generators/module/check.mjs",
    "geo:import": "pnpm --filter @bf/api geo:import"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
