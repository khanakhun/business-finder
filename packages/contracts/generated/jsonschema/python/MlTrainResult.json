        "modelCardMd": {
          "type": "string"
        },
        "preprocessing": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "preprocessing",
        "modelCardJson",
        "modelCardMd"
      ],
      "type": "object"
    },
    "baselineMetrics": {
      "additionalProperties": false,
      "properties": {
        "brier": {
          "type": [
            "number",
            "null"
          ]
        },
        "calibration": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "n": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
