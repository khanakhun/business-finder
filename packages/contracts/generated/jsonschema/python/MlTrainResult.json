    },
    "modelCard": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "spearman": {
      "type": [
        "number",
        "null"
      ]
    },
    "trainRows": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "validationRows": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
