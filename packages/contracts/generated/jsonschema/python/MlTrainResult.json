{
  "$id": "https://schemas.business-finder.dev/MlTrainResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "POST /v1/ml/train response: the chosen model, its metrics against the rule baseline, artifact hashes.",
