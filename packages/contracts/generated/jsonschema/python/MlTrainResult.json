              "predicted",
              "observed",
              "n"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "liftTop10": {
          "type": [
            "number",
            "null"
          ]
        },
        "liftTop20": {
          "type": [
            "number",
            "null"
          ]
        },
        "prAuc": {
          "type": [
            "number",
            "null"
          ]
        },
        "rocAuc": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "rocAuc",
        "prAuc",
        "brier",
        "liftTop10",
        "liftTop20",
        "calibration"
      ],
      "type": "object"
    },
    "kind": {
      "enum": [
        "logreg",
        "hgb"
      ],
      "type": "string"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "brier": {
          "type": [
            "number",
            "null"
          ]
        },
        "calibration": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "n": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              "observed": {
                "type": "number"
              },
              "predicted": {
                "type": "number"
              }
            },
            "required": [
              "predicted",
              "observed",
              "n"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "liftTop10": {
          "type": [
            "number",
            "null"
          ]
        },
        "liftTop20": {
          "type": [
            "number",
            "null"
          ]
        },
        "prAuc": {
          "type": [
            "number",
            "null"
          ]
        },
        "rocAuc": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "rocAuc",
        "prAuc",
        "brier",
        "liftTop10",
        "liftTop20",
        "calibration"
      ],
