{
  "$id": "https://schemas.business-finder.dev/OpenDataSearchResponse.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "POST /v1/open-data/places/search response on services/intel.",
  "properties": {
    "cached": {
      "description": "Served from the regional extract cache.",
      "type": "boolean"
    },
    "dataset": {
      "enum": [
        "overture",
        "foursquare"
      ],
      "type": "string"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "places": {
      "items": {
        "$ref": "https://schemas.business-finder.dev/OpenDataPlace.json"
      },
      "type": "array"
    },
    "release": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(\\.\\d{1,3})?$",
      "type": "string"
    }
  },
  "required": [
    "dataset",
    "release",
    "places",
    "nextCursor",
    "cached"
  ],
  "title": "OpenDataSearchResponse",
  "type": "object"
}
