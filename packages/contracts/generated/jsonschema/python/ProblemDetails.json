{
  "$id": "https://schemas.business-finder.dev/ProblemDetails.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "RFC 9457 problem details (application/problem+json).",
  "properties": {
    "code": {
      "enum": [
        "VALIDATION_FAILED",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "NOT_FOUND",
        "CONFLICT",
        "IDEMPOTENCY_KEY_REUSED",
        "INVALID_STATE_TRANSITION",
        "RATE_LIMITED",
        "BUDGET_EXCEEDED",
        "DISCOVERY_PROVIDER_NOT_CONFIGURED",
        "SITE_VERSION_CONFLICT",
        "EXTERNAL_SERVICE_FAILED",
        "INTERNAL"
      ],
      "type": "string"
    },
    "currentVersionId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "errors": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "items": {
              "type": [
                "string",
                "number"
              ]
            },
            "type": "array"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "instance": {
      "type": "string"
    },
    "reason": {
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "type": "string"
    },
    "refusal": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "decision": {
          "enum": [
            "manual_only",
            "blocked"
          ],
          "type": "string"
        },
        "decisionId": {
          "anyOf": [
            {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "decision",
        "decisionId",
        "reasons",
        "alternatives"
      ],
      "type": "object"
    },
    "status": {
      "maximum": 599,
      "minimum": 400,
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "traceId": {
      "type": "string"
    },
    "type": {
      "format": "uri",
      "type": "string"
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "code"
  ],
  "title": "ProblemDetails",
  "type": "object"
}
