{
  "name": "@bf/observability",
  "version": "0.0.0",
  "private": true,
  "description": "Structured redacting logger, OpenTelemetry tracing and propagation, Prometheus metrics, health checks.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome check .",
