{
  "name": "@bf/sitekit",
  "version": "0.0.0",
  "private": true,
  "description": "The site toolbelt for generation agents: validate, lint copy, apply operations, render, screenshot, check.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sitekit": "tsx --tsconfig ../site-blocks/tsconfig.json src/cli/bin.ts",
    "schemas": "tsx src/cli/write-schemas.ts",
    "schemas:check": "tsx src/cli/write-schemas.ts --check",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@axe-core/playwright": "catalog:",
    "@bf/site-blocks": "workspace:*",
    "@bf/site-schema": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "lighthouse": "13.5.0",
    "playwright": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bf/testing": "workspace:*",
    "@bf/tsconfig": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "sitekit": "./dist/sitekit.mjs"
  }
}
