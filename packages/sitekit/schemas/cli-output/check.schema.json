{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "done": {
      "type": "boolean"
    },
    "blocking": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "validationErrors": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "lintErrors": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "pagesRendered": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "screenshots": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "validationErrors",
        "lintErrors",
        "pagesRendered",
        "screenshots"
      ],
      "additionalProperties": false
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "viewport": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "locale",
          "viewport",
          "file",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    },
    "durationMs": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "done",
    "blocking",
    "warnings",
    "counts",
    "screenshots",
    "durationMs"
  ],
  "additionalProperties": false,
  "title": "sitekit check"
}
