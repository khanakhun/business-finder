{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "command": {
      "type": "string"
    },
    "ok": {
      "type": "boolean",
      "description": "false when issues were found or the site is not done (exit code 1)."
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    },
    "data": {},
    "error": {
      "description": "Usage or internal error (exit codes 2 and 3).",
      "type": "string"
    }
  },
  "required": [
    "command",
    "ok",
    "exitCode",
    "data"
  ],
  "additionalProperties": false,
  "title": "sitekit --json output"
}
