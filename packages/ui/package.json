    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@bf/testing": "workspace:*",
    "@bf/tsconfig": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@tailwindcss/postcss": "catalog:",
